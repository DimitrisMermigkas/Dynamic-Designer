{
  "name": "@jms/designer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types.d.ts",
        "default": "./dist/esm/index.js"
      }
    }
  },
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types.d.ts",
  "homepage": ".",
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "publish:dev": "cross-env NODE_ENV=development node tools/publish.js",
    "publish:prod": "cross-env NODE_ENV=testprod node tools/publish.js",
    "buildPackage": "rimraf dist && rollup -c --bundleConfigAsCjs",
    "buildPackage:obfuscated": "rimraf dist && rollup -c --bundleConfigAsCjs && npm run obfuscatePackage",
    "obfuscatePackage": "javascript-obfuscator ./dist/cjs/index.js --output ./dist/cjs/index.js --config obfuscator.config.js && javascript-obfuscator ./dist/esm/index.js --output ./dist/esm/index.js --config obfuscator.config.js",
    "obfuscateBuild": "javascript-obfuscator ./build/static/js --output ./build/static/js --config obfuscator.config.js && rimraf ./build/static/js/*.map",
    "watchBuildPackage": "rimraf dist && rollup -c --bundleConfigAsCjs --watch",
    "build:prod": "npm run build && npm run obfuscateBuild && npm run buildPackage:obfuscated"
  },
  "dependencies": {
    "@emotion/css": "^11.11.2",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/cron-converter": "^1.0.1",
    "cron-converter": "^2.1.0",
    "javascript-obfuscator": "^4.1.1",
    "moment": "^2.29.3",
    "react-scripts": "5.0.1",
    "tinycolor2": "^1.6.0",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "@azure/storage-blob": "^12.17.0",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-image": "^3.0.3",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/jest": "^27.5.2",
    "@types/luxon": "^3.4.2",
    "@types/node": "^16.18.68",
    "@types/tinycolor2": "^1.4.6",
    "bestzip": "^2.2.1",
    "cross-env": "^7.0.3",
    "dotenv": "^16.3.1",
    "rimraf": "^5.0.5",
    "rollup": "^4.9.4",
    "rollup-plugin-dts": "^6.1.0",
    "rollup-plugin-peer-deps-external": "^2.2.4"
  },
  "peerDependencies": {
    "react": "^18",
    "react-dom": "^18"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-musl": "4.24.0"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      "> 0.0001%"
    ],
    "development": [
      "> 0.0001%"
    ]
  }
}
